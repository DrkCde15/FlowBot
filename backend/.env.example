# --- Service ---
APP_NAME=flowbot-backend
ENVIRONMENT=development
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8000

# SQLite compartilhado com o Next.js (Prisma), em data/ (neutro, na raiz).
DATABASE_URL=sqlite:///../data/dev.db

# Origens permitidas (proxy do Next.js / embed)
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8000

# Rate limits
RUNTIME_RATE_LIMIT_PER_MINUTE=60
WEBHOOK_RATE_LIMIT_PER_MINUTE=120

# HMAC para webhooks de entrada e assinatura de dispatch
INTEGRATIONS_SECRET=change-me-integrations-hmac

# Integrações disparadas automaticamente a cada resposta do runtime (csv)
RUNTIME_DISPATCH_INTEGRATIONS=

# Webhook genérico
WEBHOOK_DEFAULT_URL=
WEBHOOK_DEFAULT_SECRET=

# n8n
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Slack
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# Discord
DISCORD_WEBHOOK_URL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SENDGRID_API_KEY=

# CRM (webhook genérico)
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
